# Docker image tag (default: latest). Pin to a specific version for reproducible deployments.
# IMAGE_TAG=latest

# YOLO models to preload (JSON: model -> device)
# Available: yolo26n.pt, yolo26s.pt, yolo26m.pt, yolo26l.pt, yolo26x.pt
# Device: "cpu" for CPU, "cuda:0" for NVIDIA or AMD ROCm (PyTorch ROCm aliases cuda to hip)
# YOLO_MODELS={"yolo26s.pt":"<device>","yolo26x.pt":"<device>"}

# Cache TTL for on-demand loaded models (seconds)
# YOLO_MODEL_TTL=900

# Host port for the API (container always listens on 8000)
# API_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Video output codec + CRF (quality). Pick a pair:
#   h264: CRF 18 (visually lossless) — universal, all browsers/players
#   h265: CRF 22 (visually lossless) — 30-50% smaller, limited browser support
#   av1:  CRF 23 (visually lossless) — best compression, slow encoding
# VIDEO_CODEC=auto
# VIDEO_CRF=18

# AMD only: GPU architecture override for iGPU (GMKtec mini-PCs with AMD Radeon)
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# AMD only: emergency lever against the ROCm/MIOpen fd leak. If the leak rate does not drop
# after the miopen-cache volumes + raised nofile ulimit, uncomment `MIOPEN_FIND_MODE: FAST`
# in docker-compose-amd.yml (fewer GPU-kernel compiles, at some inference-performance cost).
# Intentionally NOT a ${MIOPEN_FIND_MODE:-} pass-through: compose interpolation would always
# inject the variable (empty when unset), and MIOpen's parsing of an empty value is unverified —
# editing the compose file is the safer switch.

# Process watchdog (supervisor.py). Restarts the container when /health stops answering.
# Log lines are always written; e-mail is optional. Empty value = built-in default.
# docker-compose-*.yml forwards exactly the WATCHDOG_* variables listed in this file, except
# WATCHDOG_STOP_GRACE. The remaining knobs supervisor.py reads (WATCHDOG_HEALTH_URL, _INTERVAL,
# _TIMEOUT, _FAILURES, _MIN_UPTIME, _STOP_GRACE, _SMTP_STARTTLS; see README) are deliberately not
# forwarded: most pair with a setting in the compose file itself (healthcheck thresholds,
# stop_grace_period, the command: port), so setting one here alone changes nothing. To use one, add
# e.g. `WATCHDOG_STOP_GRACE: ${WATCHDOG_STOP_GRACE:-}` to the service's environment: in the compose
# file, then set it here.
# WATCHDOG_ENABLED=true              # false = run uvicorn without supervision (emergency lever)
# WATCHDOG_STARTUP_TIMEOUT=600       # seconds to wait for the first healthy /health (cold MIOpen compile)
# WATCHDOG_FLAP_COOLDOWN=900         # delay before restarting a container that hung <600 s after start; 0 = off
# WATCHDOG_STOP_GRACE=8              # seconds after SIGTERM before SIGKILL; keep below the compose
#                                    stop_grace_period (10 s). The wait confirming the SIGKILL is >= 1 s

# Optional e-mail on every watchdog restart. Requires WATCHDOG_SMTP_HOST; port 587 with STARTTLS
# by default. The password ends up in the container environment (visible in `docker inspect`).
# With STARTTLS the relay's certificate must be valid for its hostname; a self-signed relay makes
# the mail fail with a WARNING (the restart happens either way). WATCHDOG_SMTP_STARTTLS=false
# sends the password in the clear — for a plain relay inside a trusted network only.
# WATCHDOG_MAIL_TO=ops@example.com
# WATCHDOG_MAIL_FROM=vision-api@example.com
# WATCHDOG_SMTP_HOST=smtp.example.com
# WATCHDOG_SMTP_PORT=587
# WATCHDOG_SMTP_USER=
# WATCHDOG_SMTP_PASSWORD=
